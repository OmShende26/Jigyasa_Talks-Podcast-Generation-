# Copy this file to .env and fill in the keys. Never commit .env.
OPENROUTER_API_KEY=
# Bodhan text-to-speech key
BODHAN_API_KEY=
# Bodhan translation key (a separate key; needed for languages written in English, then translated)
BODHAN_TRANSLATE_API_KEY=
# Translation goes through Bodhan's /v1/chat/completions with this model (only change if Bodhan tells you to)
# BODHAN_TRANSLATE_MODEL=indic-translate
# Bodhan OCR key (indic-ocr), for PDFs in languages the AI cannot read. Leave empty to use BODHAN_API_KEY.
BODHAN_OCR_API_KEY=

# Models and prompts for each agent live in config/agents.yaml and prompts/.
# To try a different model without editing that file:
# MODEL_SCRIPT_WRITER=anthropic/claude-sonnet-4.5
# MODEL_REVIEWER=google/gemini-2.5-flash

# Two DIFFERENT Bodhan voices so listeners can tell the speakers apart (e.g. Kavya and Amit).
# Speaker A asks, speaker B explains. The speakers introduce themselves with these names in every format.
HOST_A_NAME=Aarav
HOST_B_NAME=Meera
HOST_A_VOICE=Amit
HOST_B_VOICE=Amit

# --- Windows: only if ffmpeg is installed but the app cannot find it ---
# FFMPEG_PATH=C:\path\to\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffmpeg\bin\ffprobe.exe

# --- Intro / outro music: put intro.mp3 and outro.mp3 in assets/ (see assets/README.md) ---
# INTRO_LEAD_SEC=2         # music alone before the first line
# INTRO_FADE_SEC=2         # music fades out under the first line
# OUTRO_OVERLAP_SEC=2      # outro starts this many seconds before the goodbye ends (0 = after it)
# OUTRO_GAP_SEC=0.6        # pause before the outro when OUTRO_OVERLAP_SEC=0
# MUSIC_VOLUME=0.6

# --- Pauses (exact: the speech engine's own silence is trimmed first) ---
# PAUSE_TURN_MIN_MS=850    # between two speakers, varied in this range
# PAUSE_TURN_MAX_MS=1000
# SENTENCES_PER_CLIP=0     # 0 = each speaker's turn is recorded as one paragraph
# TTS_CHUNK_CHARS=600      # only turns longer than this are split (at a sentence end)
# PAUSE_SENTENCE_MS=300    # pause at such a split

# --- Final check before speech (numbers and facts in translated / speech lines) ---
# FINAL_CHECK=1

# --- Length ---
# TTS_WPM=140              # how fast the voices speak; raise it if podcasts come out too short, lower if too long
# LENGTH_TOLERANCE=0.15    # a segment more than 15% over its word budget is shortened

# --- Optional tuning ---
# MAX_PARALLEL=3           # segments made at once, across everything (1 to 4). Lower it if Bodhan answers 429.
# BODHAN_MIN_INTERVAL=0.5  # seconds between Bodhan calls. Raise it if Bodhan answers 429.
# QA_ENABLED=1             # speech-to-text check of each line; switches itself off if your key cannot use it
# MAX_VISION_PAGES=40      # pages per PDF the Document Analyst may look at
# MAX_SEGMENTS=8
# MAX_REVISIONS=2          # writer/reviewer rounds after the first draft
# DATA_DIR=./data          # where sessions are stored
